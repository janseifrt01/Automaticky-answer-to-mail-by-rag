# Copy to .env and fill in. Never commit the real .env.

# --- OpenAI (required) ---
OPENAI_API_KEY=sk-...

# --- Google OAuth2 / Gmail ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/gmail/callback

# --- Mail integration ---
MAIL_PROVIDER=gmail
# Fernet key for encrypting stored OAuth credentials. Required to connect a
# mailbox. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Storage ---
DB_PATH=./data/app.db

# --- Models (OpenAI defaults; provider-swappable) ---
EMBEDDING_MODEL=text-embedding-3-small
GENERATION_MODEL=gpt-4o-mini

# --- Provider selection (defaults; runtime choice is in the Settings UI / DB) ---
# LLM_PROVIDER: openai | anthropic | github_models
LLM_PROVIDER=openai
# EMBEDDING_PROVIDER: openai | github_models | fastembed  (Anthropic has no embeddings API)
EMBEDDING_PROVIDER=openai

# --- Anthropic (Claude) — required only when LLM_PROVIDER=anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- GitHub Models (OpenAI-compatible; GitHub PAT auth) — required only when used ---
GITHUB_TOKEN=
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
GITHUB_MODELS_GENERATION_MODEL=openai/gpt-4o-mini
GITHUB_MODELS_EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Local embeddings (fastembed) — used when EMBEDDING_PROVIDER=fastembed ---
# Runs locally, no API key. BGE-small is English / 384-dim; for Czech or
# multilingual mail try intfloat/multilingual-e5-large (1024-dim). Changing the
# model changes the dimension — rebuild the index on the Knowledge Base page.
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# --- RAG / behavior ---
CONFIDENCE_THRESHOLD=0.75
REPLY_MODE=pilot
SYNC_INTERVAL_MIN=5

# Knowledge-base chunking + retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5

# Scheduler / async processing
SCHEDULER_ENABLED=true
MAX_CONCURRENCY=4

# Sending: create a native Gmail draft per reply in Pilot mode (safety net)
CREATE_GMAIL_DRAFTS=true
